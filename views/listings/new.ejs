<% layout("/layouts/boilerplate") %>
  <div class="row">
    <div class="col-8 offset-2">
      <h1>create a new listing</h1>
      <form action="/listings" method="POST" novalidate class=" needs-validation">
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input name="listing[title]" placeholder="add a catch title" type="text" class="form-control" required/>
          <div class="valid-feedback">Titlt looks good</div>
        </div>
        <br /> <br />
        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea name="listing[description]" class="form-control" required></textarea>
        </div>
        <br>

        <div class="mb-3">
          <label for="image" class="form-label">Image Link</label>
          <input name="listing[image]" placeholder="enter the image URL/Link" class="form-control">
        </div>

        <br>
        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input name="listing[price]" placeholder="enter price" type="number" class="form-control" required>
            <div class="invalid feedback">Price should be valid price</div>
          </div>
          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input name="listing[country]" placeholder="enter the country" type="text" class="form-control" required/>
            <div class="invalid-feedback">Please enter the country name</div>
            <div class="valid-feedback">nice country name</div>
            
          </div>
        </div>
        <br>
        <div class="mb-3">
          <label for="location" class="form-label">Location</label>
          <input name="listing[location]" placeholder="enter the location" type="text" class="form-control" required>
          <div class="invalid-feedback"> please enter the correct location</div>
          <div class="valid-feedback">nice place</div>
        </div>
        <br>

        <br>
        <button class="btn btn-dark">add</button>
        <br><br><br>
      </form>
    </div>

  </div>